# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Neon connection string (Dashboard → Connect). Keep ?sslmode=require on the end.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:8443

# Render sets PORT automatically; this is only used locally.
PORT=3000
